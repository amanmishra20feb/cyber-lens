# Postgres connection string, e.g. from Neon: postgres://user:password@host/db?sslmode=require
# Leave empty in development to use a throwaway in-memory Postgres (lost when the server stops).
DATABASE_URL=
# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Optional. A GitHub token (no scopes needed) raises the repo size check from 60 to 5,000 calls an hour.
GITHUB_TOKEN=
PORT=4000
